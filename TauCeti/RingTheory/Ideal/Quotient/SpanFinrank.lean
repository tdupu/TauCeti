module

public import Mathlib.Algebra.Module.SpanRank
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Generators of an ideal through a quotient

If `I ≤ J` are ideals of a commutative ring `R` with `I` finitely generated, and the image of `J`
in `R ⧸ I` is finitely generated, then `J` is generated by generators of `I` together with lifts
of generators of that image. Hence the minimal number of generators of `J` is at most that of its
image in `R ⧸ I` plus that of `I`.

## Main results

* `TauCeti.Ideal.spanFinrank_le_spanFinrank_map_add_spanFinrank`: for `I ≤ J` with `I` finitely
  generated, `J.spanFinrank ≤ (J.map (Ideal.Quotient.mk I)).spanFinrank + I.spanFinrank`.

## References

* This is the generator-lifting step in the proof of
  [Stacks Project, Lemma 10.106.7](https://stacks.math.columbia.edu/tag/00NU).
* Ported from T. Dupuy, T. Tucker and Z. Wang,
  [pcfawd-formalization](https://github.com/tdupu/pcfawd-formalization) at commit
  `9a20b3f351446d64e6015d704198bc71c7002008` (Apache-2.0),
  `lean/Pcf/Bounding/PrincipalQuotientRegular.lean`. The result generalizes its
  `Pcf.spanFinrank_maximalIdeal_le_add_one_of_principal_kernel` from a principal kernel and the
  maximal ideal of a local ring to any finitely generated ideals `I ≤ J`.
-/

public section

namespace TauCeti.Ideal

open _root_.Ideal

variable {R : Type*} [CommRing R]

/-- If `I ≤ J` are ideals with `I` finitely generated, then `J` needs at most as many generators
as its image in `R ⧸ I` and `I` together: generators of `I` and lifts of generators of the image of
`J` generate `J`. (If `J` is not finitely generated, its `spanFinrank` is `0`.) -/
theorem spanFinrank_le_spanFinrank_map_add_spanFinrank {I J : Ideal R} (hIJ : I ≤ J)
    (hI : I.FG) :
    J.spanFinrank ≤ (J.map (Ideal.Quotient.mk I)).spanFinrank + I.spanFinrank := by
  classical
  by_cases hJ : J.FG
  swap
  · simp [Submodule.spanFinrank_of_not_fg hJ]
  obtain ⟨t, ht, htspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank (hJ.map (Ideal.Quotient.mk I))
  obtain ⟨s, hs, hsspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hI
  rw [submodule_span_eq] at hsspan
  let g : R ⧸ I → R := Function.surjInv Ideal.Quotient.mk_surjective
  have hg : ∀ y, Ideal.Quotient.mk I (g y) = y := Function.surjInv_eq Ideal.Quotient.mk_surjective
  -- the lifts of the generators of the image of `J` generate `J` modulo `I`
  have hlift : (span (g '' t)).map (Ideal.Quotient.mk I) = J.map (Ideal.Quotient.mk I) := by
    rw [map_span, ← Set.image_comp, ← htspan]
    congr 1
    simp [hg]
  -- equal images modulo `I`, and `I ≤ J`
  have hspan : span (↑s ∪ g '' t) = J := by
    have hsup : span (g '' t) ⊔ I = J ⊔ I := by
      simpa only [mk_ker] using
        (map_eq_iff_sup_ker_eq_of_surjective _ Ideal.Quotient.mk_surjective).mp hlift
    rw [sup_eq_left.mpr hIJ] at hsup
    rw [span_union, hsspan, sup_comm, hsup]
  conv_lhs => rw [← hspan]
  have hfin : (↑s ∪ g '' t : Set R).Finite := s.finite_toSet.union (t.finite_toSet.image g)
  calc (span (↑s ∪ g '' t)).spanFinrank ≤ (↑s ∪ g '' t : Set R).ncard :=
        Submodule.spanFinrank_span_le_ncard_of_finite hfin
    _ ≤ (↑s : Set R).ncard + (g '' t).ncard := Set.ncard_union_le _ _
    _ ≤ s.card + t.card := by
        rw [Set.ncard_coe_finset]
        exact Nat.add_le_add_left (Set.ncard_image_le t.finite_toSet |>.trans
          (Set.ncard_coe_finset t).le) _
    _ = _ := by rw [ht, hs, add_comm]

end TauCeti.Ideal
